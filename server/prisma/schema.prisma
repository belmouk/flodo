// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id Int @id @default(autoincrement())
  firstName String @map("first_name")
  lastName String @map("last_name")
  email String @unique
  password String
  teamMemberships TeamUser[]
  projectMemberships ProjectUser[]
  taskStakes TaskUser[]
  workspaceMemberships WorkspaceUser[]
  token RefreshToken?

  @@map("users")
}

model Team {
  id Int @id @default(autoincrement())
  name String
  members TeamUser[]
  workspaces Workspace[] 

  @@map("teams")
}

model TeamUser {
  team Team @relation(fields: [teamId], references: [id])
  teamId Int @map("team_id")
  user User @relation(fields: [userId], references: [id])
  userId Int @map("user_id")
  userRole TeamUserRole
  assignedAt DateTime @default(now()) @map("assigned_at")
  @@id([userId, teamId])
}

enum TeamUserRole {
  ADMIN
  MEMBER
}

model Project {
  id Int @id @default(autoincrement())
  name String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @map("updated_at")
  members ProjectUser[]
  @@map("projects")
}

model ProjectUser {
  user User @relation(fields: [userId], references: [id])
  userId Int @map("user_id")
  project Project @relation(fields: [projectId], references: [id])
  projectId Int @map("project_id")
  assignedAt DateTime @default(now()) @map("assigned_at")
  userRole ProjectUserRole
  @@id([userId, projectId])
}

enum ProjectUserRole {
  OWNER
  MEMBER
}

model Task {
  id Int @id @default(autoincrement())
  content String
  status TaskStatus @default(WIP)
  dueAt DateTime @map("due_at")
  createdAt DateTime @default(now()) @map("created_at")
  completedAt DateTime @map("completed_at")
  stakeholders TaskUser[]
  @@map("tasks")
}

enum TaskStatus {
  DONE
  WIP
  OVERDUE
  @@map("task_status")
}

model TaskUser {
  stakeholder User @relation(fields: [stakeholderId], references: [id])
  stakeholderId Int @map("stakeholder_id")
  task Task @relation(fields: [taskId], references: [id])
  taskId Int @map("task_id")
  assignedAt DateTime @default(now()) @map("assigned_at")
  userRole TaskUserRole
  @@id([stakeholderId, taskId])
}

enum TaskUserRole {
  ASSIGNER
  ASSIGNEE
}

model Workspace {
  id Int @id @default(autoincrement())
  name String
  createdAt DateTime @default(now()) @map("created_at")
  members WorkspaceUser[]
  team Team? @relation(fields: [teamId], references: [id])
  teamId Int? @map("team_id")

  @@map("workspaces")
}

model WorkspaceUser {
  user User @relation(fields: [userId], references: [id])
  userId Int @map("user_id")
  workspace Workspace @relation(fields: [workspaceId], references: [id])
  workspaceId Int @map("workspace_id")
  assignedAt DateTime @default(now()) @map("assigned_at")
  userRole WorkspaceUserRole
  @@id([userId, workspaceId])
}

enum WorkspaceUserRole {
  ADMIN
  MEMBER
}

model RefreshToken {
  id Int @id @default(autoincrement())
  token String
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime 
  jti String
  user User @relation(fields: [userId], references: [id])
  userId Int @unique
  @@map("refresh_tokens")
}


